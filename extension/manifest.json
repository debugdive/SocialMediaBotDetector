{
  "manifest_version": 3,
  "name": "InstaAI Bot & News Detector",
  "version": "3.0",
  "description": "Scans Instagram profiles and verifies highlighted Fake News anywhere.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
